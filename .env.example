# Picsur 環境變數設定範例
# 複製此檔案為 .env 並填入實際值

# ===== 應用程式設定 =====
# 主機位址 (0.0.0.0 允許所有介面連接)
PICSUR_HOST=0.0.0.0

# 應用程式 Port (預設 8080)
PICSUR_PORT=8080

# 生產模式 (部署時務必設定為 true)
PICSUR_PRODUCTION=true

# 詳細日誌模式 (開發時可設為 true，生產建議 false)
PICSUR_VERBOSE=false

# 遙測功能 (是否回報使用統計)
PICSUR_TELEMETRY=true

# ===== 資料庫設定 =====
# PostgreSQL 資料庫主機
PICSUR_DB_HOST=localhost

# PostgreSQL Port (預設 5432)
PICSUR_DB_PORT=5432

# 資料庫名稱
PICSUR_DB_DATABASE=picsur

# 資料庫使用者名稱
PICSUR_DB_USERNAME=picsur

# 資料庫密碼 (生產環境請使用強密碼)
PICSUR_DB_PASSWORD=picsur

# ===== Demo 模式設定 =====
# 是否啟用 Demo 模式 (會定期清理資料)
PICSUR_DEMO=false

# Demo 模式清理間隔（毫秒）預設 5 分鐘
PICSUR_DEMO_INTERVAL=300000

# ===== Zeabur 部署注意事項 =====
# 在 Zeabur 上部署時：
# 1. 確保已新增 PostgreSQL 服務
# 2. Zeabur 會自動注入以下變數（需要手動映射）：
#    - POSTGRES_HOST -> PICSUR_DB_HOST
#    - POSTGRES_PORT -> PICSUR_DB_PORT
#    - POSTGRES_USER -> PICSUR_DB_USERNAME
#    - POSTGRES_PASSWORD -> PICSUR_DB_PASSWORD
#    - POSTGRES_DATABASE -> PICSUR_DB_DATABASE
# 3. 手動設定 PICSUR_PRODUCTION=true
# 4. PORT 環境變數會由 Zeabur 自動設定，映射到 PICSUR_PORT
